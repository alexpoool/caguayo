# API base URL (must include trailing path, no trailing slash)
# Example: VITE_API_BASE_URL=http://10.0.0.15:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Marca del cliente (opcional; el default es "ERP"). Cada despliegue pone
# aquí su nombre; si se define EMPRESA_NOMBRE en la configuración del
# backend (/api/v1/config/branding), el backend manda y esto es el fallback.
VITE_EMPRESA_NOMBRE=ERP
VITE_EMPRESA_RAZON_SOCIAL=ERP S.C.
