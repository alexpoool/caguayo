# API base URL (must include trailing path, no trailing slash)
# Example: VITE_API_BASE_URL=http://10.0.0.15:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Marca del cliente (opcional; el backend manda vía /api/v1/config/branding
# y esto es solo fallback). Esta instalación: Caguayo. Otras instalaciones
# ponen aquí el nombre de su propio cliente.
VITE_EMPRESA_NOMBRE=Caguayo
VITE_EMPRESA_RAZON_SOCIAL=CAGUAYO S.A.
