# Branding de la instalación
EMPRESA_NOMBRE=Caguayo
EMPRESA_RAZON_SOCIAL=CAGUAYO S.A.

# El backend queda accesible solo desde Nginx en producción.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Esta base debe coincidir con AUTH_DATABASE del .env raíz.
DATABASE_URL=postgresql+psycopg://caguayo:change-me@127.0.0.1:5432/caguayo

# Rol dedicado de PostgreSQL para la aplicación (requiere CREATEDB).
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=caguayo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caguayo_sa
DB_PORT=5432
DEBUG=False
CORS_ORIGINS=https://caguayo.home.arpa

# Credenciales administrativas para crear bases y realizar respaldos.
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=5432
ADMIN_DB_USER=caguayo
ADMIN_DB_PASSWORD=change-me
ADMIN_DB_NAME=postgres
BACKUP_DIR=/var/backups/postgresql

# Base central para replicar esquema a nuevos tenants.
CENTRAL_DATABASE=caguayo_sa

LECTOR_USER=caguayo
LECTOR_PASSWORD=change-me

# Messaging / thesis prototype
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MESSAGE_TOPIC=caguayo.messages

# Local LLM (llama.cpp OpenAI-compatible server)
LLM_PROVIDER=llama.cpp
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
