# ── Branding de la instalación ────────────────────────────────
EMPRESA_NOMBRE=Caguayo
EMPRESA_RAZON_SOCIAL=CAGUAYO S.A.

# El backend queda accesible solo desde Nginx en producción.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# La base de DATABASE_URL debe coincidir con AUTH_DATABASE del .env raíz.
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/caguayo

# PostgreSQL — credenciales locales de la instalación.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caguayo_sa
DB_PORT=5432
DEBUG=False
CORS_ORIGINS=https://caguayo.home.arpa

# Credenciales administrativas para crear bases, respaldos y migraciones.
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=5432
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=change-me
ADMIN_DB_NAME=postgres

# Directorio de respaldos.
BACKUP_DIR=/var/backups/postgresql

# Base central para replicar esquema a nuevos tenants (también en .env raíz).
CENTRAL_DATABASE=caguayo_sa

# Usuario de solo lectura para comprobaciones.
LECTOR_USER=postgres
LECTOR_PASSWORD=change-me
