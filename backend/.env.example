# Server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Environment variables for the application
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/database_name

# PostgreSQL — dueño de la configuración de base.
# Estas cuatro las lee el ETL de migración (etl/config.py): las busca primero en
# este fichero y sólo después en el .env de la raíz. Replican la base de
# DATABASE_URL; si divergen, Configuración → Migración avisa y no deja ejecutar.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caguayo_sa
DB_PORT=5432
DEBUG=True
CORS_ORIGINS=http://localhost:5173

# Admin database credentials (for creating new dependency databases)
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=5432
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=password
ADMIN_DB_NAME=postgres

# Central database name (main database with all tenants config)
CENTRAL_DATABASE=caguayo_sa

# Read-only user for testing database connections
LECTOR_USER=postgres
LECTOR_PASSWORD=password
