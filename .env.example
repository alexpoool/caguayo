# Caguayo — variables de entorno
# Copia este archivo a .env y completa tus valores.
#
# La configuración de PostgreSQL (POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB, DB_PORT) no vive aquí: está en backend/.env, que es su dueño.
# Ver backend/.env.example.

# Backend
SECRET_KEY=change-me-to-a-random-64-char-string
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Multi-tenant: BD central para replicar esquema a tenants nuevos
CENTRAL_DATABASE=caguayosa

# Frontend (build-time arg)
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173
