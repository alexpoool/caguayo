# Caguayo — variables de entorno
# Copia este archivo a .env y completa tus valores.

# PostgreSQL
POSTGRES_USER=caguayo_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caguayo
DB_PORT=5432

# Backend
SECRET_KEY=change-me-to-a-random-64-char-string
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Multi-tenant: BD central para replicar esquema a tenants nuevos
CENTRAL_DATABASE=caguayosa

# Frontend (build-time arg)
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173
